{
  "name": "volunterr",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:apps",
    "dev:local": "npm run db:up && npm run dev:apps",
    "dev:apps": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "install:all": "npm install --prefix server && npm install --prefix client",
    "build": "npm run build --prefix client",
    "test": "npm run test:unit",
    "test:unit": "npm run test:unit --prefix server",
    "test:backend": "npm run test:backend --prefix server",
    "test:frontend": "npm run test:frontend --prefix server",
    "test:integration": "npm run test:integration --prefix server",
    "test:all": "npm run test:all --prefix server",
    "test:coverage": "npm run test:coverage --prefix server",
    "db:up": "docker compose up -d mongodb",
    "db:down": "docker compose down",
    "seed": "npm run seed --prefix server",
    "seed:provinces": "npm run seed:provinces --prefix server",
    "migrate:atlas": "npm run migrate:atlas --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
